{
  "$schema": "http://json.schemastore.org/template",
  "author": "Dorn Contributors",
  "classifications": ["Web", "WebAPI", "Clean Architecture"],
  "identity": "Dorn.Templates.WebApi",
  "name": "Dorn Clean Architecture Web API",
  "description": "Production-ready Clean Architecture Web API with CQRS, layered structure, and Docker support.",
  "shortName": "dorn-webapi",
  "preferNameDirectory": true,
  "sourceName": "CleanArchWebApi",
  "symbols": {
    "IncludeTests": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Include the xUnit test projects: Unit (Application), Integration (real DatabaseProvider), Architecture (layering rules), and Functional (HTTP endpoints)."
    },
    "Orm": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        { "choice": "efcore", "description": "Entity Framework Core — migrations, change tracking, DbContext (default)." },
        { "choice": "dapper", "description": "Dapper — micro-ORM, raw SQL, maximum control and performance." }
      ],
      "defaultValue": "efcore",
      "description": "The Object-Relational Mapper used for data access."
    },
    "UseEfCore": { "type": "computed", "value": "(Orm == \"efcore\")" },
    "UseDapper": { "type": "computed", "value": "(Orm == \"dapper\")" },
    "DatabaseProvider": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        { "choice": "sqlite", "description": "SQLite — no external setup required (default)." },
        { "choice": "sqlserver", "description": "SQL Server, run via an Aspire-managed container." }
      ],
      "defaultValue": "sqlite",
      "description": "The EF Core database provider used for persistence."
    },
    "UseSqlite": { "type": "computed", "value": "(DatabaseProvider == \"sqlite\")" },
    "UseSqlServer": { "type": "computed", "value": "(DatabaseProvider == \"sqlserver\")" },
    "UsePostgres": { "type": "computed", "value": "(DatabaseProvider == \"postgres\")" },
    "Orchestrator": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        {
          "choice": "aspire",
          "description": "Local orchestration via .NET Aspire AppHost (default)."
        },
        {
          "choice": "docker-compose",
          "description": "Docker Compose scaffolding; no Aspire dependency."
        },
        {
          "choice": "none",
          "description": "No orchestration scaffolding; run the API directly."
        }
      ],
      "defaultValue": "aspire",
      "description": "Local orchestration approach for the generated service."
    },
    "UseAspire": { "type": "computed", "value": "(Orchestrator == \"aspire\")" },
    "UseCompose": { "type": "computed", "value": "(Orchestrator == \"docker-compose\")" }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!IncludeTests)",
          "exclude": ["tests/**"]
        },
        {
          "condition": "(UseDapper)",
          "exclude": [
            "src/CleanArchWebApi.Infrastructure/Repositories/EfCore/**",
            "src/CleanArchWebApi.Infrastructure/Persistence/Migrations/**",
            "src/CleanArchWebApi.Infrastructure/Persistence/ApplicationDbContext.cs"
          ]
        },
        {
          "condition": "(UseEfCore)",
          "exclude": ["src/CleanArchWebApi.Infrastructure/Repositories/Dapper/**"]
        },
        {
          "condition": "(UseSqlServer)",
          "rename": {
            "src/CleanArchWebApi.Infrastructure/Persistence/Migrations/SqlServer/": "src/CleanArchWebApi.Infrastructure/Persistence/Migrations/"
          },
          "exclude": ["src/CleanArchWebApi.Infrastructure/Persistence/Migrations/Sqlite/**"]
        },
        {
          "condition": "(UseSqlite)",
          "rename": {
            "src/CleanArchWebApi.Infrastructure/Persistence/Migrations/Sqlite/": "src/CleanArchWebApi.Infrastructure/Persistence/Migrations/"
          },
          "exclude": ["src/CleanArchWebApi.Infrastructure/Persistence/Migrations/SqlServer/**"]
        },
        {
          "condition": "(!UseAspire)",
          "exclude": [
            "src/CleanArchWebApi.AppHost/**",
            "src/CleanArchWebApi.ServiceDefaults/**"
          ]
        },
        {
          "condition": "(UseAspire)",
          "exclude": ["CleanArchWebApi.Compose.slnx"]
        },
        {
          "condition": "(!UseCompose)",
          "exclude": ["docker-compose.yml", "docker-compose.SqlServer.yml"]
        },
        {
          "condition": "(!UseAspire)",
          "rename": {
            "CleanArchWebApi.Compose.slnx": "CleanArchWebApi.slnx"
          },
          "exclude": ["CleanArchWebApi.slnx"]
        },
        {
          "condition": "(UseCompose && UseSqlServer)",
          "rename": {
            "docker-compose.SqlServer.yml": "docker-compose.yml"
          },
          "exclude": ["docker-compose.yml"]
        },
        {
          "condition": "(UseCompose && UseSqlite)",
          "exclude": ["docker-compose.SqlServer.yml"]
        },
        {
          "condition": "(UseSqlServer)",
          "rename": {
            ".github/config/db-provider.txt.tpl-sqlserver": ".github/config/db-provider.txt"
          },
          "exclude": [".github/config/db-provider.txt.tpl-sqlite"]
        },
        {
          "condition": "(UseSqlite)",
          "rename": {
            ".github/config/db-provider.txt.tpl-sqlite": ".github/config/db-provider.txt"
          },
          "exclude": [".github/config/db-provider.txt.tpl-sqlserver"]
        }
      ]
    }
  ],
  "postActions": [
    {
      "description": "Restore NuGet packages required by this project.",
      "manualInstructions": [
        {
          "text": "Run 'dotnet restore'"
        }
      ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    }
  ],
  "tags": {
    "language": "C#",
    "type": "project"
  }
}
