<Project>
  <!-- Self-contained; MSBuild imports only the nearest props file. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Fixed MVP (design D2): no #if/Use*/DefineConstants, unlike templates/webapi. -->
</Project>
