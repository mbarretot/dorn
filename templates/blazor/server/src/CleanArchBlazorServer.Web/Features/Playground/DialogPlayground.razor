@page "/playground/dialog"

<PageTitle>Playground · Dialog</PageTitle>

<div class="mx-auto flex max-w-2xl flex-col gap-8 p-8">
    <PlaygroundSection
        Title="Modal dialog"
        Description="Opens above all page content with a backdrop, traps focus, locks background scroll, and dismisses on Escape or an outside click."
    >
        <Dialog>
            <DialogTrigger Class="@Button.ResolveClass(ButtonVariant.Default, ButtonSize.Default, null)">
                Open dialog
            </DialogTrigger>
            <DialogContent>
                <DialogHeader>
                    <DialogTitle>Edit profile</DialogTitle>
                    <DialogDescription>
                        Make changes to your profile here. Press Escape or click outside to close.
                    </DialogDescription>
                </DialogHeader>
                <DialogFooter>
                    <DialogClose Class="@Button.ResolveClass(ButtonVariant.Outline, ButtonSize.Default, null)">
                        Cancel
                    </DialogClose>
                    <DialogClose Class="@Button.ResolveClass(ButtonVariant.Default, ButtonSize.Default, null)">
                        Save
                    </DialogClose>
                </DialogFooter>
            </DialogContent>
        </Dialog>
    </PlaygroundSection>
</div>
