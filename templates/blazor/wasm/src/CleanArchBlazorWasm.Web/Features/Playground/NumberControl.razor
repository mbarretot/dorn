@using System.Globalization

<div class="flex flex-col gap-1.5" data-testid="@($"control-{Label}")">
    <span class="text-sm font-medium text-foreground">@Label</span>
    <Input Type="number" Value="@ValueAsString" ValueChanged="HandleChangedAsync" ValueExpression="() => ValueAsString" />
</div>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter]
    public double Value { get; set; }

    [Parameter]
    public EventCallback<double> ValueChanged { get; set; }

    private string ValueAsString => Value.ToString(CultureInfo.InvariantCulture);

    private Task HandleChangedAsync(string value) =>
        double.TryParse(value, NumberStyles.Float, CultureInfo.InvariantCulture, out var parsed)
            ? ValueChanged.InvokeAsync(parsed)
            : Task.CompletedTask;
}
