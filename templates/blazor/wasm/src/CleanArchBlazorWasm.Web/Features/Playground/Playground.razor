@page "/playground"

<PageTitle>Playground</PageTitle>

<div class="mx-auto flex max-w-2xl flex-col gap-6 p-8">
    <div class="flex flex-col gap-1">
        <h1 class="text-3xl font-bold text-foreground">Component playground</h1>
        <p class="text-muted-foreground">
            Live, interactive demos of every component shipped in this design system.
        </p>
    </div>
    <nav class="grid grid-cols-2 gap-3 sm:grid-cols-3">
        @foreach (var link in Links)
        {
            <a
                href="@link.Href"
                class="rounded-lg border border-border bg-card p-4 text-sm font-medium text-card-foreground shadow-sm transition-colors hover:bg-accent hover:text-accent-foreground"
            >
                @link.Label
            </a>
        }
    </nav>
</div>

@code {
    private static readonly (string Href, string Label)[] Links =
    [
        ("/playground/button", "Button"),
        ("/playground/card", "Card"),
        ("/playground/dialog", "Dialog"),
        ("/playground/dropdown-menu", "DropdownMenu"),
        ("/playground/form", "Form (Input + Label)"),
        ("/playground/select", "Select"),
        ("/playground/tabs", "Tabs"),
    ];
}
