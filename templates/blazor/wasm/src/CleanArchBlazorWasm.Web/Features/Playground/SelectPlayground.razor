@page "/playground/select"
@layout PlaygroundLayout

<PageTitle>Playground · Select</PageTitle>

<ComponentPlayground
    Title="Select"
    Description="Arrow/Home/End move between options; Enter/Space/Tab commit and close; Escape cancels."
    CodeSnippet="@CodeSnippet"
    ApiParameters="ApiParameters"
>
    <Controls>
        <p class="text-sm text-muted-foreground">Options are fixed list items — pick one in the preview to see the bound value below.</p>
    </Controls>
    <Preview>
        <div class="flex flex-col gap-1.5">
            <Label For="color-select">Favorite color</Label>
            <Select @bind-Value="_selectedColor" Placeholder="Choose a color" id="color-select">
                <SelectItem Value="@("red")">Red</SelectItem>
                <SelectItem Value="@("green")">Green</SelectItem>
                <SelectItem Value="@("blue")">Blue</SelectItem>
            </Select>
        </div>
        <p class="text-sm text-muted-foreground">Selected: @(string.IsNullOrEmpty(_selectedColor) ? "none" : _selectedColor)</p>
    </Preview>
</ComponentPlayground>

@code {
    private string _selectedColor = "";

    private const string CodeSnippet =
        """
        <Select @bind-Value="_selectedColor" Placeholder="Choose a color">
            <SelectItem Value="@("red")">Red</SelectItem>
            <SelectItem Value="@("green")">Green</SelectItem>
            <SelectItem Value="@("blue")">Blue</SelectItem>
        </Select>
        """;

    private static readonly PlaygroundParameter[] ApiParameters =
    [
        new("Value", "TValue", "-", "The bound selected value (two-way bindable)."),
        new("Placeholder", "string?", "null", "Text shown when no value is selected."),
    ];
}
