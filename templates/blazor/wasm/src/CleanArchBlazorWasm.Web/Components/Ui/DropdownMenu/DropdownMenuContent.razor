@implements IAsyncDisposable
<div
    @ref="_element"
    id="@Context.ContentId"
    role="menu"
    aria-labelledby="@Context.TriggerId"
    popover="manual"
    class="@ComputedClass"
    @attributes="AdditionalAttributes"
>
    @ChildContent
</div>

@code {
    private const string BaseClass =
        "z-50 min-w-[8rem] overflow-hidden rounded-md border border-border bg-popover p-1 text-popover-foreground shadow-md";

    private ElementReference _element;
    private DotNetObjectReference<DropdownMenuContent>? _dotNetRef;
    private bool _pendingOpen;
    private bool _pendingClose;
    private bool _wasOpen;

    [CascadingParameter]
    private DropdownMenuContext Context { get; set; } = default!;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? Side { get; set; } = "bottom";

    [Parameter]
    public string? Align { get; set; } = "start";

    [Parameter]
    public double Offset { get; set; } = 4;

    [Parameter]
    public double CollisionPadding { get; set; } = 8;

    [Parameter]
    public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    [Inject]
    private AnchorInterop AnchorInterop { get; set; } = default!;

    [Inject]
    private DismissInterop DismissInterop { get; set; } = default!;

    private string ComputedClass => Cn.Merge(BaseClass, Class);

    protected override void OnParametersSet()
    {
        if (Context is null)
        {
            throw new InvalidOperationException(
                "DropdownMenuContent must be rendered inside a <DropdownMenu>."
            );
        }

        if (Context.IsOpen && !_wasOpen)
        {
            _pendingOpen = true;
        }
        else if (!Context.IsOpen && _wasOpen)
        {
            _pendingClose = true;
        }

        _wasOpen = Context.IsOpen;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Items only register into Context.Focus (setting the initial ActiveId) from their
            // own OnAfterRender, which runs after this render already produced tabindex="-1" for
            // every item. One extra render reflects the now-registered roving-focus state.
            StateHasChanged();
        }

        if (_pendingOpen && !_element.Equals(default(ElementReference)))
        {
            _pendingOpen = false;
            _dotNetRef ??= DotNetObjectReference.Create(this);
            await AnchorInterop.ShowAsync(_element);
            await AnchorInterop.PositionAsync(
                Context.TriggerElement,
                _element,
                Side ?? "bottom",
                Align ?? "start",
                Offset,
                CollisionPadding
            );
            await DismissInterop.ActivateAsync(Context.ContentId, _element, _dotNetRef);
            await Context.FocusActiveItemAsync();
        }
        else if (_pendingClose)
        {
            _pendingClose = false;
            await DismissInterop.DeactivateAsync(Context.ContentId);
            await AnchorInterop.DisposeAsync(_element);
            await AnchorInterop.HideAsync(_element);
            await Context.FocusTriggerAsync();
        }
    }

    [JSInvokable]
    public Task RequestDismissAsync() => Context.RequestClose();

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (Context.IsOpen)
            {
                await DismissInterop.DeactivateAsync(Context.ContentId);
                await AnchorInterop.DisposeAsync(_element);
            }
        }
        catch (JSDisconnectedException)
        {
            // Circuit/module already gone — nothing left to clean up JS-side.
        }
        finally
        {
            _dotNetRef?.Dispose();
        }
    }
}
